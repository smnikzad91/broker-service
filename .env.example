# Same database the Next.js app uses — this service reads/writes the
# MqttUser / MqttClient / MqttActivity / MqttPayload collections directly.
MONGODB_URI=mongodb://user:pass@host:port/mqttcloudir?authSource=admin

# Plaintext MQTT port
MQTT_PORT=1883

# TLS MQTT port — only started if both TLS_CERT_PATH and TLS_KEY_PATH are set
# and readable. Leave unset to run plaintext-only (e.g. local dev).
MQTT_TLS_PORT=8883
TLS_CERT_PATH=
TLS_KEY_PATH=

# Live connect/disconnect push to the dashboard (Socket.IO). SOCKET_SHARED_SECRET
# must match the same value the Next.js app has in its own .env — it's what
# lets the broker verify the short-lived token the dashboard mints for itself
# at /api/user/mqtt/socket-token before it's allowed to join a user's room.
SOCKET_PORT=4021
SOCKET_SHARED_SECRET=change-me-to-a-random-value-shared-with-the-nextjs-app
DASHBOARD_ORIGIN=http://localhost:3000
